<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Diskwise</vendor>
  <action id="io.github.diskwise.Diskwise.read-power-states">
    <description>Read drive power state information</description>
    <message>Authentication is required to read the power state table of a drive</message>
    <icon_name>io.github.diskwise.Diskwise</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/diskwise-helper</annotate>
  </action>
</policyconfig>
